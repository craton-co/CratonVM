+        long timeout = HTTPD_READY_TIMEOUT_DEFAULT_MS;
+        String configured = System.getProperty(HTTPD_READY_TIMEOUT);
+        if (configured != null && !configured.isEmpty()) {
+            timeout = Long.parseLong(configured);
+        }
+        long deadline = System.currentTimeMillis() + timeout;
         while (System.currentTimeMillis() < deadline) {
             try (@SuppressWarnings("unused") Socket ignored = new Socket("localhost", this.httpdPort)) {
                 return true;
             } catch (IOException e) {
+                if (!p.isAlive()) {
