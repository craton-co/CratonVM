     private static final String HTTPD_PATH = "tomcat.test.httpd.path";
 
+    /*
+     * How long to wait for httpd to bind its listener before giving up.
+     *
+     * Upstream hard-codes 1000 ms, which is fine on Linux where httpd binds in
+     * tens of milliseconds. On Windows the MPM WinNT startup path (process
+     * creation + module init + "Child: Starting 64 worker threads") measures a
+     * consistent 1.0-1.5 s, so the upstream deadline expires *just* before the
+     * listener comes up and every httpd integration class fails with a
+     * connection-refused to the proxy port. Waiting longer costs nothing when
+     * httpd is fast, and the loop also exits early once the process dies.
+     */
+    private static final String HTTPD_READY_TIMEOUT = "tomcat.test.httpd.readyTimeoutMs";
+    private static final long HTTPD_READY_TIMEOUT_DEFAULT_MS = 30_000;
+
     private Process p;
 
