#JavaTest Interviewer Configuration Template for RustJVM
#
# This file is a template for configuring the JCK JavaTest harness to run
# against the RustJVM vm-cli binary. Copy this file and adjust paths before
# use.
#
# Prerequisites:
#   - JCK downloaded under OCTLA or TCK Community License (see docs/legal.md)
#   - RustJVM built: cargo build --release -p vm-cli
#   - JAVA_HOME pointing to a JDK 25 installation (for reference comparison)
#
# Usage:
#   cd $JCK_HOME
#   java -jar lib/javatest.jar -config /path/to/javatest_config.jti
#
# See also: https://openjdk.org/groups/conformance/JckAccess/

# --- Test Suite Location ---
# Point to the JCK test suite root directory.
TESTSUITE=$JCK_HOME

# --- Test Platform (the VM under test) ---
# The command to invoke the VM under test.
# Replace /path/to/rustjvm with the actual path to the built vm-cli binary.
TESTPLATFORM.command=/path/to/rustjvm/target/release/vm-cli

# The display name for the platform under test.
TESTPLATFORM.name=RustJVM

# --- Classpath ---
# The JCK tests directory containing compiled test classes.
TESTPLATFORM.testClasspath=$JCK_HOME/tests

# Additional classpath entries (JCK library classes).
TESTPLATFORM.refClasspath=$JCK_HOME/classes

# --- VM Arguments ---
# Arguments passed to the VM under test for every test invocation.
# --synthetic-jdk: use built-in Rust stubs instead of real JDK bytecode
# Adjust heap size as needed for the test workload.
TESTPLATFORM.vmArgs=--synthetic-jdk -Xmx512m

# --- Java Compiler ---
# Path to javac for compiling test sources (uses the reference JDK).
TESTPLATFORM.compiler=$JAVA_HOME/bin/javac

# --- Concurrency ---
# Number of tests to run in parallel. Set based on available CPU cores.
# Start with 1 for debugging, increase for throughput.
CONCURRENCY=1

# --- Timeout ---
# Per-test timeout in seconds. JCK tests should complete quickly;
# a long timeout catches infinite loops in the VM under test.
TIMEOUT=120

# --- Output ---
# Directory for test results and reports.
WORKDIR=./jck-work

# --- Test Selection ---
# Run all tests by default. Override on the command line or here to
# restrict to specific API areas.
#
# Examples:
#   TESTS=api/java_lang         -- only java.lang tests
#   TESTS=api/java_util/HashMap -- only HashMap tests
#   TESTS=api                   -- all API tests
#
# Leave blank or set to "." for the full test suite.
TESTS=.

# --- Keywords ---
# Keyword expressions to filter tests. Common JCK keywords:
#   runtime   -- tests that exercise runtime behavior
#   compiler  -- tests that exercise compilation
#   positive  -- tests expected to succeed
#   negative  -- tests expected to fail (error handling)
#
# Default: run all keywords.
KEYWORDS=

# --- Exclude List ---
# Path to a file listing tests to exclude (known failures).
# Generate from bench/jck-failures.json or maintain manually.
# EXCLUDELIST=./jck-exclude.jtx

# --- Prior Status ---
# Rerun only previously failed tests (useful for iteration).
# Set to "fail" to rerun failures, or leave blank for full runs.
PRIORSTATUS=

# --- Reporting ---
# Generate an HTML report after the run.
REPORT=true
REPORTDIR=./jck-report
