# Compiled Java bytecode — stray probe/repro .class files must not be committed.
# NOTE: .class files in test_classes/ and demo/ are intentional test fixtures
# and are explicitly kept checked in via the negation patterns below.
*.class
!test_classes/**/*.class
!demo/**/*.class
!vm-cli/tests/resources/**/*.class

# JAR files (benchmark dependencies — download separately)
bench/*.jar

# Bench fixture caches (Maven Central downloads, EJBCA dist zip, WildFly tgz, etc.)
bench/**/cache/
bench/**/staged/
bench/**/staged-*/
bench/wildfly-boot/wildfly-*.tar.gz
bench/wildfly-boot/wildfly-*.zip
bench/ejbca-deploy/ejbca_ce_*.zip

# Temp files
*.tmp

# Windows artifacts
nul

# Distribution binaries
dist/*.exe
dist/*.dll

# macOS
.DS_Store

