target/
**/*.rs.bk
*.swp
*.swo
*~
.idea/
.tools/
.vscode/
*.iml
apps/
!apps/letsgo/
!apps/SportMe-master/
!apps/demo/
# Lightweight smoke probes shipped with the orchestrator — exercise an app's
# core class init / utils chain when the upstream launcher entrypoint is
# unsuitable as a smoke test (e.g. jetty start.jar wants a configured
# jetty.base, cassandra nodetool requires JMX-over-RMI, felix Gogo hangs
# when stdout is a file, kc26 quarkus-run.jar SEGVs on non-TTY output).
!apps/jetty_probe/
!apps/cassandra_probe/
!apps/felix_probe/
!apps/kc26_probe/
!apps/wildfly_probe/
!apps/kc16_probe/
!apps/activemq_probe/
!apps/kafka_probe/
!apps/hazelcast_probe/
!apps/solr_probe/
.smoke-cache/
**/*.jar
**/*.tar.gz
apps/**/*.tar.gz

# Compiled Java bytecode — stray probe/repro .class files must not be committed.
# NOTE: .class files in test_classes/ and demo/ are intentional test fixtures
# and are explicitly kept checked in via the negation patterns below.
*.class
!test_classes/**/*.class
!demo/**/*.class
!vm-cli/tests/resources/**/*.class

# JAR files (benchmark dependencies — download separately)
bench/*.jar

# Bench fixture caches (Maven Central downloads, EJBCA dist zip, WildFly tgz, etc.)
bench/**/cache/
bench/**/staged/
bench/**/staged-*/
bench/wildfly-boot/wildfly-*.tar.gz
bench/wildfly-boot/wildfly-*.zip
bench/ejbca-deploy/ejbca_ce_*.zip

# Temp files
*.tmp

# Windows artifacts
nul

# Distribution binaries
dist/*.exe
dist/*.dll

# macOS
.DS_Store

# Windows
Thumbs.db

# Claude Code
.claude/

# Internal-only docs (not for OSS distribution)
docs/internal/

# Application logs
applogs/

# Root executables
*.exe
!dist/*.exe

# Stray developer probe / build artifacts at the repo root
/librust_out.rmeta
/sf-desc.txt
*.dis
__pycache__/
