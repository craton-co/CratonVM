target/
**/*.rs.bk
*.swp
*.swo
*~
.idea/
.tools/
.vscode/
*.iml
apps/
!apps/letsgo/
!apps/SportMe-master/
!apps/demo/
.smoke-cache/
**/*.jar
**/*.tar.gz
apps/**/*.tar.gz

# Compiled Java bytecode — stray probe/repro .class files must not be committed.
# NOTE: .class files in test_classes/ and demo/ are intentional test fixtures
# and are explicitly kept checked in via the negation patterns below.
*.class
!test_classes/**/*.class
!demo/**/*.class
!vm-cli/tests/resources/**/*.class
# Smoke / functional probes shipped with the orchestrator. Each probe
# is a tiny single-class workload that drives a meaningful chunk of an
# app's library code (OpenWire round-trip, OSGi framework lifecycle,
# jboss-modules class loader, etc.) — see docstring on run_smoke /
# run_functional in scripts/orchestrator.sh.
!test-infra/probes/**/*.class
# Spring Framework jars used by the springboot probe. Checked in so the
# probe can compile + run without a network fetch at smoke time.
# See test-infra/spring-libs/ and func_springboot in scripts/orchestrator.sh.
!test-infra/spring-libs/**/*.jar

# JAR files (benchmark dependencies — download separately)
bench/*.jar

# Bench fixture caches (Maven Central downloads, EJBCA dist zip, WildFly tgz, etc.)
bench/**/cache/
bench/**/staged/
bench/**/staged-*/
bench/wildfly-boot/wildfly-*.tar.gz
bench/wildfly-boot/wildfly-*.zip
bench/ejbca-deploy/ejbca_ce_*.zip

# Temp files
*.tmp

# Windows artifacts
nul

# Distribution binaries
dist/*.exe
dist/*.dll

# macOS
.DS_Store

# Windows
Thumbs.db

# Claude Code
.claude/

# Internal-only docs (not for OSS distribution)
docs/internal/

# Application logs
applogs/

# Root executables
*.exe
!dist/*.exe

# Stray developer probe / build artifacts at the repo root
/librust_out.rmeta
/sf-desc.txt
*.dis
__pycache__/
